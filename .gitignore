# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build-event-data で生成する静的なイベントデータ
/public/data/

# Remotion。依存と、レンダー前に落とすサムネはコミットしない
/remotion/node_modules/
/remotion/props/generated/
/remotion/public/thumbs/
/remotion/.remotion/

# promo（告知用スライド）の作業ファイル
/promo/.venv/
/promo/shots/
/promo/node_modules/
__pycache__/
*.py[cod]
